{
	"name": "kili-spatial",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun node_modules/vite/bin/vite.js dev",
		"build": "bun scripts/seo.mjs && bun node_modules/vite/bin/vite.js build",
		"preview": "bun node_modules/vite/bin/vite.js preview",
		"prepare": "bun node_modules/@sveltejs/kit/svelte-kit.js sync",
		"check": "bun node_modules/@sveltejs/kit/svelte-kit.js sync && bun node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun node_modules/@sveltejs/kit/svelte-kit.js sync && bun node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json --watch",
		"build:data": "bun scripts/build-data.mjs",
		"seo": "bun scripts/seo.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/geojson": "^7946.0.16",
		"pngjs": "^7.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"lucide-svelte": "^1.0.1",
		"maplibre-gl": "^6.14.0"
	},
	"packageManager": "bun@1.4.3",
	"license": "AGPL-3.0-only",
	"description": "Open-source 3D trekking viewer for Mount Kilimanjaro's Marangu Route",
	"keywords": [
		"kilimanjaro",
		"maplibre",
		"svelte",
		"sveltekit",
		"3d-map",
		"trekking",
		"hiking",
		"terrain",
		"gpx",
		"openstreetmap",
		"tanzania",
		"embeddable"
	],
	"author": "Cleven G",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cleven12/kili-spatial.git"
	},
	"homepage": "https://kili.xenohuru.com",
	"bugs": {
		"url": "https://github.com/cleven12/kili-spatial/issues"
	}
}
